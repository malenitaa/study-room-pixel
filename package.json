{
  "name": "study-room-pixel",
  "version": "0.2.0",
  "description": "Ambient pixel-art study room — looping scene audio and a focus timer",
  "author": "Malena",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "generate-audio": "node scripts/generate-audio.mjs",
    "verify:security": "npm run build && electron scripts/verify-security.mjs",
    "verify:persistence": "npm run build && node scripts/verify-persistence.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^32.2.6",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
